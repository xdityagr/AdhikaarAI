# Twilio credentials — get from https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Webhook config
WEBHOOK_BASE_URL=https://your-tunnel.ngrok.io
WEBHOOK_VERIFY_SIGNATURES=true

# Database
DATABASE_PATH=data/yojnasetu.db

# Rate limiting
MAX_MESSAGES_PER_USER_PER_MINUTE=10

# Worker config
WORKER_COUNT=3

# Content Templates for quick-reply buttons (optional — leave empty for text-only mode)
# Create templates in Twilio Console → Content Template Builder, then paste SIDs here
CONTENT_SID_PROJECT_TYPE=
CONTENT_SID_GENDER=
USE_BUTTON_MESSAGES=false

# Gemini AI (Phase 3)
GEMINI_API_KEY=

# --- Loan defaults (from NSFDC direct verification) ---
DEFAULT_TENURE_MONTHS=84
DEFAULT_MORATORIUM_MONTHS=6

# --- LLM models ---
GEMINI_MODEL_EXTRACTION=gemini-2.5-flash-lite
GEMINI_MODEL_GENERATION=gemini-2.5-flash

# --- Financial literacy ---
# Informal moneylender rate, % PER MONTH, for the comparison message.
# 3-10%/month is typical. An assumption you can change, not a hidden constant.
MONEYLENDER_MONTHLY_RATE_PCT=5.0

# --- Aadhaar offline e-KYC ---
# Real verification needs UIDAI's signing certificate at
# corpus/uidai_signing_cert.pem. Without it the app says so rather than
# claiming a check it didn't perform.
# Set this to demonstrate the verification path against a clearly-labelled
# DEMO certificate instead. Never enable it in production.
EKYC_DEMO_MODE=false

# --- WhatsApp door (web) ---
# The published helpline number the QR code and 'Continue on WhatsApp' button
# point at. Public by design: it is printed on the page. Digits, spaces and
# punctuation are all fine — only the digits are used.
NEXT_PUBLIC_WHATSAPP_NUMBER=+1 555 197 0478

# --- Phone door (web) ---
# The published number people ring. Leave it EMPTY and the "Call and ask"
# button does not render at all — a call button that cannot place a call is a
# promise broken in public, so there is no placeholder state for this one.
#
# Vapi's free numbers are US-national only. A caller in India pays
# international rates to reach a +1, and many prepaid plans bar ISD outright,
# so the door says so before showing the digits. Publish an Indian DID before
# this goes on a leaflet. See docs/SPIKE-voice-vapi.md.
NEXT_PUBLIC_HELPLINE_NUMBER=

# --- Inbound voice (Vapi) ---
VAPI_API_KEY=
# A string we choose and paste into Vapi's credential config. Every
# /api/voice/* request is checked against it; unset means the routes refuse
# everything rather than run the matcher for whoever finds the URL.
VAPI_WEBHOOK_SECRET=
VAPI_PHONE_NUMBER_ID=
